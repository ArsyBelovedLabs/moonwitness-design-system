{
  "$schema": "https://moonwitness.biz.id/design-tokens/v1",
  "meta": {
    "name": "MoonWitness Master Visual Tokens",
    "status": "implementation-aligned",
    "owner": "moonwitness-frontend-platform",
    "editorMirror": "moonwitness-design-system/openpencil"
  },
  "color": {
    "void": "#040506",
    "panel": "#090C0F",
    "raised": "#101419",
    "ivory": "#F0EADF",
    "muted": "#8E949B",
    "hairline": "#2A3036",
    "crimson": "#D7281E",
    "amber": "#A77A3A",
    "success": "#6F9C7A",
    "warning": "#B58A52",
    "danger": "#B84D46",
    "cyan": "#6D97A0"
  },
  "surface": {
    "canvas": "#040506",
    "panel": "rgba(9,12,15,0.96)",
    "glass": "rgba(16,20,25,0.82)",
    "focus": "rgba(215,40,30,0.14)"
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "none": 0,
    "instrument": 2,
    "control": 4,
    "sheet": 8
  },
  "stroke": {
    "hairline": 1,
    "active": 1,
    "focus": 2
  },
  "typography": {
    "display": { "family": "serif", "size": 36, "weight": 600, "lineHeight": 42 },
    "title": { "family": "sans", "size": 22, "weight": 600, "lineHeight": 28 },
    "body": { "family": "sans", "size": 14, "weight": 400, "lineHeight": 21 },
    "label": { "family": "sans", "size": 11, "weight": 600, "lineHeight": 14, "tracking": 1.6 },
    "telemetry": { "family": "mono", "size": 12, "weight": 500, "lineHeight": 16 }
  },
  "frame": {
    "desktop1440": { "width": 1440, "height": 900 },
    "desktop1280": { "width": 1280, "height": 800 },
    "tablet1024": { "width": 1024, "height": 768 },
    "mobile430": { "width": 430, "height": 932 },
    "mobile390": { "width": 390, "height": 844 },
    "mobile360": { "width": 360, "height": 800 }
  },
  "motion": {
    "fast": 120,
    "standard": 180,
    "slow": 320,
    "reducedMotion": "disable nonessential orbit/reveal motion"
  },
  "semanticState": [
    "FROZEN BASELINE",
    "LIVE",
    "CANDIDATE",
    "VERIFIED",
    "PARTIAL",
    "OFFLINE",
    "ERROR",
    "DISABLED"
  ]
}
